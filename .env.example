# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database (Railway PostgreSQL)
DATABASE_URL=
# Postgres connection pool size (per app instance). Default 20. Raise for higher
# concurrency; keep below your Postgres max_connections divided by replica count.
DB_POOL_MAX=20

# Realtime: Centrifugo is the single real-time transport (chat, presence, typing,
# board updates). See centrifugo/README.md for the Railway service setup.
# If these are unset the app falls back to polling/refresh and skips publishes.
CENTRIFUGO_HTTP_API=http://localhost:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=
NEXT_PUBLIC_CENTRIFUGO_WS=ws://localhost:8000/connection/websocket

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=falak-crm

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
