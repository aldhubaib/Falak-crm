## 6. Buttons

```tsx
// Primary action — full width on mobile
<button className="w-full lg:w-auto min-h-touch px-6 rounded-xl text-button font-semibold
  bg-primary text-primary-foreground flex items-center justify-center gap-2">
  <Check className="w-icon-sm h-icon-sm" />
  Save
</button>

// Secondary action
<button className="min-h-touch px-4 rounded-xl text-button font-medium
  text-muted-foreground border border-border flex items-center justify-center gap-2
  hover:bg-muted/20">
  <X className="w-icon-sm h-icon-sm" />
  Cancel
</button>

// Icon-only button
<button className="w-icon-btn h-icon-btn rounded-lg flex items-center justify-center
  text-muted-foreground hover:text-foreground hover:bg-muted transition-colors">
  <MoreHorizontal className="w-icon-md h-icon-md" />
</button>
```

### Action bar pattern (bottom of cards/modals)

```tsx
<div className="flex items-center border-t border-border/40">
  <button className="flex-1 flex items-center justify-center gap-2 min-h-touch
    text-button font-medium text-muted-foreground hover:text-primary hover:bg-primary/5">
    <Calendar className="w-icon-sm h-icon-sm" />
    Reschedule
  </button>
  <div className="w-px h-5 bg-border/30" />
  <button className="flex-1 flex items-center justify-center gap-2 min-h-touch
    text-button font-medium text-muted-foreground hover:text-red-400 hover:bg-red-500/5">
    <Trash2 className="w-icon-sm h-icon-sm" />
    Remove
  </button>
</div>
```

