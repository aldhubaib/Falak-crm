generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Workspace ─────────────────────────────────────────────────────────────────

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  baseCurrency    String   @default("KWD")
  taxRate         Decimal  @default(15) @db.Decimal(5, 2)
  logo            String?
  // Branding slot (BrandingSlotId) whose asset is shown on invoices.
  invoiceLogoSlot String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members            WorkspaceMember[]
  activityLogs       ActivityLog[]
  industries         Industry[]
  referrals          Referral[]
  companies          Company[]
  contacts           Contact[]
  services           Service[]
  deals              Deal[]
  projects           Project[]
  invoices           Invoice[]
  payments           Payment[]
  pipelines          Pipeline[]
  projectStatuses    ProjectStatus[]
  taskStatuses       TaskStatus[]
  customFields       CustomFieldDef[]
  whatsappConfig     WhatsAppConfig?
  whatsappTemplates  WhatsAppTemplate[]
  integrations       IntegrationCredential[]
  roles              Role[]
  titles             Title[]
  currencies         Currency[]
  exchangeRates      ExchangeRate[]
  attachments        Attachment[]
  checklistTemplates ChecklistTemplate[]
  conversations      Conversation[]
  publishItems       PublishItem[]
}

// ─── Currencies & Exchange Rates ──────────────────────────────────────────────

model Currency {
  id          String   @id @default(cuid())
  workspaceId String
  code        String // ISO: "KWD", "SAR", "USD", "EUR"
  name        String // "Kuwaiti Dinar", "Saudi Riyal"
  symbol      String // "د.ك", "﷼", "$"
  isBase      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  workspaceId   String
  fromCurrency  String // e.g. "SAR"
  toCurrency    String // always base currency e.g. "KWD"
  rate          Decimal  @db.Decimal(12, 6) // 1 fromCurrency = X toCurrency
  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fromCurrency, toCurrency])
}

// ─── Team & Roles ──────────────────────────────────────────────────────────────

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String // Clerk user ID
  email       String
  name        String?
  imageUrl    String? // Clerk/Google profile photo
  type        MemberType @default(MEMBER)
  roleId      String?
  titleId     String? // capacity title (Junior A, Senior…) — effort rates, not permissions
  weeklyHours Float      @default(40) // working-hours capacity per week
  joinedAt    DateTime   @default(now())

  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role                     Role?                     @relation(fields: [roleId], references: [id])
  capacityTitle            Title?                    @relation(fields: [titleId], references: [id], onDelete: SetNull)
  assignedTasks            Task[]                    @relation("TaskAssignee")
  messages                 Message[]                 @relation("CommentAuthor")
  mentionedIn              MessageMention[]          @relation("MentionedIn")
  reactions                MessageReaction[]         @relation("ReactionAuthor")
  notifications            Notification[]            @relation("NotificationRecipient")
  pushSubscriptions        PushSubscription[]
  scheduledItems           PublishItem[]             @relation("PublishScheduler")
  projectMemberships       ProjectMember[]           @relation("ProjectTeam")
  statusChanges            TaskStatusChange[]        @relation("StatusChangeMember")
  conversations            ConversationParticipant[] @relation("ConversationMember")
  responsibleWeeklyTargets ProjectWeeklyTarget[]     @relation("WeeklyTargetResponsible")
  assignedWeeklySlots      WeeklySlot[]              @relation("WeeklySlotAssignee")

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum MemberType {
  OWNER
  MEMBER
  FREELANCER
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  permissions Json // { deals: "full", invoices: "view", ... }
  createdAt   DateTime @default(now())

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  projectMembers ProjectMember[]

  @@unique([workspaceId, name])
}

// ─── Capacity Titles ───────────────────────────────────────────────────────────
// A Title (Junior A, Junior B, Senior, Creator…) carries effort rates: how many
// minutes of work a unit of content costs for people holding that title.
// Separate from Role, which is permissions only.

model Title {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    WorkspaceMember[]
  fieldRates TitleFieldRate[]
  stageRates TitleStageRate[]

  @@unique([workspaceId, name])
}

// Rate for one checklist-template field: minutes per unit of that field's
// effortUnit (per word, per audio minute, per video minute). For "fixed"
// fields the quantity is always 1, so this doubles as flat minutes.
model TitleFieldRate {
  id             String @id @default(cuid())
  titleId        String
  templateItemId String
  minutesPerUnit Float

  title        Title                 @relation(fields: [titleId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)

  @@unique([titleId, templateItemId])
}

// Flat minutes charged each time a task passes through a stage (review stages).
model TitleStageRate {
  id             String @id @default(cuid())
  titleId        String
  statusId       String
  minutesPerPass Float

  title  Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  status TaskStatus @relation("TitleStageRates", fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([titleId, statusId])
}

// ─── Freelancer Access ─────────────────────────────────────────────────────────

model ProjectCollaborator {
  id         String             @id @default(cuid())
  projectId  String
  memberId   String
  status     CollaboratorStatus @default(PENDING)
  invitedAt  DateTime           @default(now())
  invitedVia String? // "whatsapp" | "email"

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ─── Companies & Contacts ──────────────────────────────────────────────────────

model Company {
  id             String    @id @default(cuid())
  workspaceId    String
  ownerId        String? // Clerk user ID of record owner
  ownerName      String?
  name           String
  nameAr         String?
  industry       String?
  referral       String?
  phone          String?
  whatsappNumber String?
  email          String?
  website        String?
  address        String?
  countries      String[]  @default([]) // ISO2 codes of operating countries
  logo           String?
  notes          String?
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String? // WorkspaceMember ID of who trashed it

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactCompany[]
  deals     Deal[]
  projects  Project[]

  @@index([workspaceId, deletedAt])
}

model Contact {
  id           String    @id @default(cuid())
  workspaceId  String
  ownerId      String? // Clerk user ID of record owner
  ownerName    String?
  firstName    String
  middleName   String?
  lastName     String
  nameAr       String?
  mobile       String
  email        String?
  role         String?
  country      String
  notes        String?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String? // WorkspaceMember ID of who trashed it

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companies        ContactCompany[]
  deals            Deal[]
  invoices         Invoice[]
  whatsappMessages WhatsAppMessage[]

  @@unique([workspaceId, mobile])
  @@index([workspaceId, deletedAt])
}

model ContactCompany {
  id        String   @id @default(cuid())
  contactId String
  companyId String
  role      String? // Role at this specific company
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
}

// ─── Services Catalog ──────────────────────────────────────────────────────────

model Service {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String?
  pricingType PricingType @default(FIXED)
  unitPrice   Decimal     @db.Decimal(12, 2)
  unit        String? // "month", "piece", "hour", etc.
  taxable     Boolean     @default(true)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dealItems DealItem[]
  tasks     Task[]
}

enum PricingType {
  FIXED
  MONTHLY
  PER_UNIT
  HOURLY
}

// ─── Pipelines & Stages (Dynamic) ─────────────────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId, isDefault])
}

model PipelineStage {
  id         String    @id @default(cuid())
  pipelineId String
  name       String
  order      Int
  color      String    @default("#3b82f6")
  type       StageType @default(OPEN)
  createdAt  DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
}

enum StageType {
  OPEN
  WON
  LOST
}

// ─── Deals ─────────────────────────────────────────────────────────────────────

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  pipelineId        String
  stageId           String
  companyId         String?
  contactId         String?
  ownerId           String? // Clerk user ID of record owner
  ownerName         String?
  title             String
  value             Decimal   @db.Decimal(12, 2)
  currency          String    @default("KWD")
  rateToBase        Decimal?  @db.Decimal(12, 6) // Locked exchange rate at time of creation
  valueInBase       Decimal?  @db.Decimal(12, 2) // Value converted to base currency using locked rate
  expectedCloseDate DateTime?
  discountType      String    @default("percent") // "percent" or "fixed"
  discountValue     Decimal   @default(0) @db.Decimal(12, 3)
  lostReason        String?
  notes             String?
  customFields      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?
  deletedAt         DateTime?
  deletedBy         String? // WorkspaceMember ID of who trashed it

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items        DealItem[]
  project      Project?
  accessGrants DealAccess[]
  invoices     Invoice[]

  @@index([workspaceId, deletedAt])
}

model DealAccess {
  id          String    @id @default(cuid())
  dealId      String
  email       String
  name        String?
  token       String    @unique @default(cuid())
  permissions Json // { project: true, invoices: true, tasks: true }
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, email])
}

model DealItem {
  id          String  @id @default(cuid())
  dealId      String
  serviceId   String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  description String? // Override description for this deal

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([dealId])
}

// ─── Projects ──────────────────────────────────────────────────────────────────

model ProjectStatus {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@unique([workspaceId, order])
}

model Project {
  id                String    @id @default(cuid())
  workspaceId       String
  dealId            String?   @unique
  companyId         String?
  contactId         String?
  ownerId           String? // Clerk user ID of record owner
  ownerName         String?
  statusId          String?
  name              String
  type              String    @default("fixed") // "fixed" or "recurring"
  thumbnailId       String? // File ID for project thumbnail
  description       String?
  requirePublishing Boolean   @default(false)
  startDate         DateTime?
  deadline          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedBy         String? // WorkspaceMember ID of who trashed it

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal             Deal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company          Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status           ProjectStatus?        @relation(fields: [statusId], references: [id])
  tasks            Task[]
  invoices         Invoice[]
  collaborators    ProjectCollaborator[]
  projectTemplates ProjectTemplate[]
  folders          ProjectFolder[]
  assets           ProjectAsset[]
  publishItems     PublishItem[]
  members          ProjectMember[]
  messages         Message[]
  weeklyTargets    ProjectWeeklyTarget[]
  weeklySlots      WeeklySlot[]

  @@index([workspaceId, deletedAt])
}

// ─── Weekly Plan ────────────────────────────────────────────────────────────────

// Per-project weekly capacity: how many tasks of each type the project should
// deliver per week. Drives the empty slots shown in the Todo column.
model ProjectWeeklyTarget {
  id                  String   @id @default(cuid())
  projectId           String
  templateId          String
  // Tasks to deliver per week on the unified calendar (Sunday-start weeks,
  // due Thursday end-of-day).
  perWeek             Int      @default(0)
  // Cadence: slots are produced every N weeks (1 = weekly, 2 = biweekly…),
  // counted from startsOn's week. Off-weeks produce no slots.
  intervalWeeks       Int      @default(1)
  // First planned week (Sunday 00:00 Kuwait). A plan saved with "starts next
  // week" shows its first slots under "Next week" instead of "Due".
  startsOn            DateTime @default(now())
  // Project member responsible for filling this template's weekly slots.
  responsibleMemberId String?

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template          ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responsibleMember WorkspaceMember?  @relation("WeeklyTargetResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)

  @@unique([projectId, templateId])
}

// One row per Todo slot per week. Seeded lazily from the weekly targets when
// the board loads; a slot is "filled" once a task claims it by moving into
// Todo. Admins can soft-remove empty slots for the current week (removedAt).
model WeeklySlot {
  id         String    @id @default(cuid())
  projectId  String
  templateId String
  weekStart  DateTime // Sunday 00:00 Kuwait — the unified week grid (stored as UTC)
  taskId     String?   @unique
  assigneeId String? // Member responsible for filling this slot
  dueDate    DateTime? // Explicit deadline (force-added slots); falls back to Thursday 23:59 of the week
  removedAt  DateTime?
  createdAt  DateTime  @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  task     Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignee WorkspaceMember?  @relation("WeeklySlotAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, weekStart])
  @@index([assigneeId, weekStart])
  // Todo gate: free-slot lookup / count by type within the week.
  @@index([projectId, templateId, weekStart])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  roleId    String?
  addedAt   DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation("ProjectTeam", fields: [memberId], references: [id], onDelete: Cascade)
  role    Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([projectId, memberId])
  @@index([memberId])
}

// ─── Project Assets ─────────────────────────────────────────────────────────────

model ProjectFolder {
  id        String    @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  deletedBy String? // WorkspaceMember ID of who trashed it

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ProjectFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectFolder[] @relation("FolderTree")
  assets   ProjectAsset[]

  @@index([projectId, parentId])
}

model ProjectAsset {
  id          String    @id @default(cuid())
  projectId   String
  folderId    String?
  name        String
  fileSize    Int
  contentType String
  r2Key       String
  uploadedBy  String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedBy   String? // WorkspaceMember ID of who trashed it

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([projectId, folderId])
}

// ─── Checklist Templates ────────────────────────────────────────────────────────

model ChecklistTemplate {
  id                     String   @id @default(cuid())
  workspaceId            String
  name                   String
  icon                   String?
  color                  String? // hex color e.g. "#22d3ee"
  description            String?
  publishToCalendar      Boolean  @default(true) // completed tasks of this type go to the publish calendar
  // Lock rule for the built-in task Title, same semantics as field locks:
  // null = Auto (locks once the task leaves Todo), stage id = locks from that
  // stage, titleNeverLock = editable at every stage.
  titleLockedFromStageId String?
  titleNeverLock         Boolean  @default(false)
  // Custom display of the built-in Title on task forms — rendering only,
  // tasks still store a plain Task.title. Null = default "Task Title" copy.
  titleLabel             String?
  titleHelp              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  titleLockedFromStage TaskStatus?             @relation("TitleLockedFromStage", fields: [titleLockedFromStageId], references: [id], onDelete: SetNull)
  items                ChecklistTemplateItem[]
  sections             ChecklistSection[]
  projects             ProjectTemplate[]
  weeklyTargets        ProjectWeeklyTarget[]
  tasks                Task[]                  @relation("TaskType")
  weeklySlots          WeeklySlot[]
}

// A named group of checklist fields on a task type (e.g. "Requirements",
// "Delivery", "Raw Assets"). Sections are renamable, addable, and removable;
// their `phase` carries the behavior the rest of the app keys on:
// "create" = filled on the new-task form, locks after Todo (Requirements-like);
// "delivery" = filled during work, gated behind leaving Todo (Delivery-like).
// Items mirror their section's phase so all stage-gate logic stays unchanged.
model ChecklistSection {
  id         String   @id @default(cuid())
  templateId String
  name       String
  phase      String   @default("delivery") // "create" or "delivery"
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  template ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecklistTemplateItem[]

  @@index([templateId])
}

model ChecklistTemplateItem {
  id                    String  @id @default(cuid())
  templateId            String
  name                  String
  type                  String  @default("text") // "text", "select", "file_upload", "textarea", "link", "yes_no", "checkbox"
  role                  String  @default("any")
  options               String? // JSON array for select type e.g. '["Option A","Option B"]'
  allowedFileTypes      String?
  allowedFormats        String? // JSON array e.g. '["mp4","mov"]'
  aspectRatio           String? // e.g. "16:9", "9:16", "1:1"
  mandatory             Boolean @default(false)
  phase                 String  @default("create") // "create" or "delivery" — mirrors the section's phase
  sectionId             String? // owning section; null = legacy, grouped by phase
  visibleFromStageId    String?
  requiredBeforeStageId String?
  lockedFromStageId     String?
  neverLock             Boolean @default(false) // field stays editable at every stage
  publishCard           String  @default("hidden") // placement on the publish card: "hidden" | "expanded" | "always"
  hidden                Boolean @default(false) // disabled: kept (with task data) but not shown or enforced anywhere
  // Effort measurement: null = no effort, or "words" | "audio_min" | "video_min" | "fixed"
  effortUnit            String?
  order                 Int     @default(0)

  template            ChecklistTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section             ChecklistSection?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  visibleFromStage    TaskStatus?         @relation("VisibleFromStage", fields: [visibleFromStageId], references: [id], onDelete: SetNull)
  requiredBeforeStage TaskStatus?         @relation("RequiredBeforeStage", fields: [requiredBeforeStageId], references: [id], onDelete: SetNull)
  lockedFromStage     TaskStatus?         @relation("LockedFromStage", fields: [lockedFromStageId], references: [id], onDelete: SetNull)
  taskItems           TaskChecklistItem[]
  titleRates          TitleFieldRate[]

  @@index([templateId])
}

model ProjectTemplate {
  id         String @id @default(cuid())
  projectId  String
  templateId String

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([projectId, templateId])
}

model TaskChecklistItem {
  id                    String    @id @default(cuid())
  taskId                String
  templateItemId        String?
  name                  String
  type                  String    @default("text")
  role                  String    @default("any")
  options               String?
  allowedFileTypes      String?
  allowedFormats        String? // JSON array e.g. '["mp4","mov"]'
  aspectRatio           String? // e.g. "16:9", "9:16", "1:1"
  mandatory             Boolean   @default(false)
  phase                 String    @default("create") // "create" or "delivery"
  visibleFromStageId    String?
  requiredBeforeStageId String?
  lockedFromStageId     String?
  neverLock             Boolean   @default(false) // field stays editable at every stage
  publishCard           String    @default("hidden") // placement on the publish card: "hidden" | "expanded" | "always"
  hidden                Boolean   @default(false) // disabled: kept (with task data) but not shown or enforced anywhere
  effortUnit            String? // snapshot: null | "words" | "audio_min" | "video_min" | "fixed"
  completed             Boolean   @default(false)
  attachmentId          String?
  textValue             String?
  completedAt           DateTime?
  completedBy           String?
  // Effort locked at field completion — only changes on explicit Recalculate.
  effortQuantity        Float?
  effortRate            Float?
  effortMinutes         Float?
  effortLockedAt        DateTime?
  order                 Int       @default(0)

  task         Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  // One row per template field per task — concurrent getTask materialisation
  // can't duplicate fields (NULL templateItemId = custom rows, exempt).
  @@unique([taskId, templateItemId])
  @@index([taskId])
  @@index([templateItemId])
  // Title-wide effort recalculation filters on these.
  @@index([completedBy, effortLockedAt])
}

// ─── Tasks ─────────────────────────────────────────────────────────────────────

model TaskStatus {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks               Task[]
  visibleFromItems    ChecklistTemplateItem[] @relation("VisibleFromStage")
  requiredBeforeItems ChecklistTemplateItem[] @relation("RequiredBeforeStage")
  lockedFromItems     ChecklistTemplateItem[] @relation("LockedFromStage")
  titleLockTemplates  ChecklistTemplate[]     @relation("TitleLockedFromStage")
  titleStageRates     TitleStageRate[]        @relation("TitleStageRates")

  @@unique([workspaceId, order])
}

model Task {
  id                String    @id @default(cuid())
  projectId         String
  taskNumber        Int       @default(0)
  serviceId         String?
  statusId          String?
  assigneeId        String?
  // Task type (ChecklistTemplate). Stored directly so the type survives even
  // when the template has no fields (nothing to infer from checklist items).
  templateId        String?
  title             String
  description       String?
  billable          Boolean   @default(true)
  price             Decimal?  @db.Decimal(12, 2)
  publish           Boolean   @default(true) // goes to the publish calendar when completed (stamped from task type)
  priority          Int?
  estimateMin       Int?
  plannedMinutes    Float? // planned video length in minutes (null = 2-min baseline)
  dueDate           DateTime?
  completedAt       DateTime?
  assignmentHistory Json?
  stageTimings      Json?
  stageEnteredAt    DateTime?
  rejectionCount    Int       @default(0)
  order             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedBy         String? // WorkspaceMember ID of who trashed it

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service        Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status         TaskStatus?         @relation(fields: [statusId], references: [id])
  template       ChecklistTemplate?  @relation("TaskType", fields: [templateId], references: [id], onDelete: SetNull)
  assignee       WorkspaceMember?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklistItems TaskChecklistItem[]
  comments       Message[]
  publishItem    PublishItem?
  weeklySlot     WeeklySlot?

  statusChanges TaskStatusChange[]

  @@index([projectId, statusId])
  @@index([projectId, order])
  @@index([projectId, deletedAt])
  // Board query: live tasks per project grouped by column.
  @@index([projectId, deletedAt, statusId])
  @@index([projectId, templateId])
  // Publish queue: completed/review tasks with publishing enabled.
  @@index([statusId, publish, deletedAt])
}

model TaskStatusChange {
  id             String   @id @default(cuid())
  taskId         String
  memberId       String?
  action         String // "created", "status_change"
  fromStatusId   String?
  fromStatusName String?
  toStatusId     String?
  toStatusName   String?
  durationMs     Int? // time spent in fromStatus before this move
  createdAt      DateTime @default(now())

  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member WorkspaceMember? @relation("StatusChangeMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// ─── Messages (unified: task comments, rejections, project chat, DMs) ──────────
// One model backs every message surface. A message belongs to exactly one thread:
//   - taskId set          → task thread (comments + rejections)
//   - projectId always set for task/project messages → project "Everything" feed
//   - conversationId set   → direct/group message
// Centrifugo delivers these live; this table is the durable source of truth.
// NOTE: kept mapped to the original "TaskComment" table so existing rows survive.

model Message {
  id             String   @id @default(cuid())
  taskId         String?
  projectId      String?
  conversationId String?
  replyToId      String?
  authorId       String // WorkspaceMember ID
  body           String // Plain text with @[Name](memberId) mentions
  kind           String   @default("message") // "message" | "rejection" | "system"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task         Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       WorkspaceMember   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentions     MessageMention[]
  reactions    MessageReaction[]

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@map("TaskComment")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())

  message Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation("ReactionAuthor", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
}

model MessageMention {
  id        String @id @default(cuid())
  messageId String @map("commentId")
  memberId  String

  message Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation("MentionedIn", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId])
  @@map("CommentMention")
}

// ─── Conversations (direct + group messages) ──────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  isGroup     Boolean  @default(false)
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([workspaceId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  memberId       String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation("ConversationMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String // "mention", "comment", "assignment", "status_change", "rejection"
  title       String
  body        String?
  linkUrl     String?
  // Web-push tag the OS notification was shown with — lets us close it on
  // other devices when this notification is read.
  tag         String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient WorkspaceMember @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
  // Inbox unread rollup (GROUP BY linkUrl) + mark-thread-read by linkUrl.
  @@index([recipientId, read, linkUrl])
}

model PushSubscription {
  id         String   @id @default(cuid())
  memberId   String
  endpoint   String   @unique
  p256dh     String
  auth       String
  // Device hygiene: which browser/OS this is, and when it last synced.
  // Subscriptions unseen for 90+ days are pruned during sync.
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ─── Invoices ──────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  workspaceId   String
  projectId     String?
  contactId     String?
  dealId        String?
  number        String // Auto-generated: INV-001, INV-002, etc.
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  discountType  String        @default("percent") // "percent" or "fixed"
  discountValue Decimal       @default(0) @db.Decimal(12, 3)
  total         Decimal       @db.Decimal(12, 2)
  rateToBase    Decimal?      @db.Decimal(12, 6) // Locked exchange rate at time of creation
  totalInBase   Decimal?      @db.Decimal(12, 2) // Total converted to base currency using locked rate
  currency      String        @default("KWD")
  notes         String?
  issueDate     DateTime?
  dueDate       DateTime?
  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  paidAt        DateTime?
  rejectionNote String?
  publicToken   String        @unique @default(cuid()) // For public invoice link
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PARTIAL
  PAID
  CANCELLED
}

// A payment received against an invoice ("Payments Received" module). The
// sum of an invoice's payments drives its PARTIAL / PAID status.
model Payment {
  id              String   @id @default(cuid())
  workspaceId     String
  invoiceId       String
  number          String // Sequential: "1071", "1072", ...
  date            DateTime
  location        String?
  type            String   @default("Invoice Payment") // Invoice Payment | Retainer | Advance
  mode            String   @default("Bank Transfer") // Cash | Check | Bank Transfer | Credit Card | Other
  referenceNumber String?
  amount          Decimal  @db.Decimal(12, 3)
  currency        String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId, date])
  @@index([invoiceId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  details     String? // Longer description shown under the item title
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxPct      Decimal? @db.Decimal(5, 2) // Per-item tax percentage
  total       Decimal  @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── Scripts ──────────────────────────────────────────────────────────────────
//
// Owned entirely by src/modules/script. workspaceId / projectId / taskId are
// plain strings on purpose — NOT Prisma relations. A foreign key into Project
// or Task would weld the two modules together, so that every CRM migration
// starts risking scripts and vice versa. Referential integrity is enforced in
// src/modules/script/integration.ts, the one file allowed to read CRM data.

model Script {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  taskId        String? // set when an approved script is pushed into a task
  title         String
  status        String    @default("draft") // draft|researching|ready|writing|review|approved
  targetMinutes Float?
  dialect       String    @default("kuwaiti")
  tone          String?
  platform      String?
  createdBy     String? // WorkspaceMember ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sources ScriptSource[]

  @@index([workspaceId, deletedAt])
  @@index([projectId])
}

model ScriptSource {
  id          String    @id @default(cuid())
  scriptId    String
  type        String // youtube|text
  url         String?
  title       String?
  author      String?
  publishedAt DateTime?
  durationSec Int?
  // 3 = documentary/verified, 2 = ordinary, 1 = weak. Breaks conflict ties later.
  trustLevel  Int       @default(2)
  language    String? // detected from the raw text
  captionKind String? // manual|auto|unknown|n/a — feeds the default trust level
  rawText     String?   @db.Text
  cleanedText String?   @db.Text
  segments    Json? // [{ text, startSec }] when the API returns timed cues
  status      String    @default("queued") // queued|fetching|ready|failed
  error       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId, order])
}

// ─── Integrations ─────────────────────────────────────────────────────────────

// Third-party credentials, one row per workspace per provider. `secrets` is an
// AES-256-GCM blob (see src/lib/secrets.ts) holding every field for the
// provider; `hints` carries the masked forms that are safe to render.
model IntegrationCredential {
  id              String    @id @default(cuid())
  workspaceId     String
  provider        String // IntegrationProvider id, e.g. "openai"
  secrets         String // encrypted JSON: { [fieldKey]: value }
  hints           Json? // { [fieldKey]: "sk-••••4f2a" } for display only
  enabled         Boolean   @default(true)
  lastVerifiedAt  DateTime?
  lastVerifyError String?
  updatedBy       String? // WorkspaceMember ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

// ─── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsAppConfig {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  phoneNumberId String
  accessToken   String
  verifyToken   String
  businessName  String?
  connected     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  event       String // "invoice_sent", "invoice_reminder", "deal_update", etc.
  body        String // Template with {{variables}}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, event])
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  contactId   String
  direction   MessageDirection
  body        String
  templateId  String?
  status      MessageStatus    @default(PENDING)
  linkedType  String? // "invoice", "deal", "project"
  linkedId    String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Activity Log ──────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String // Clerk user ID
  userName    String?
  userImage   String?
  entityType  String // "company", "contact", "deal", "project", "task", "invoice", "service"
  entityId    String
  entityName  String? // Snapshot of the entity name at time of change
  action      String // "created", "updated", "deleted", "moved", "sent", "accepted", "rejected", "paid"
  changes     Json? // { field: { from: "old", to: "new" } }
  metadata    Json? // Extra context (e.g. stage name for deal moves)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
}

// ─── Industries (Dynamic) ──────────────────────────────────────────────────────

model Industry {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Referral {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// ─── Custom Fields (Dynamic) ───────────────────────────────────────────────────

model CustomFieldDef {
  id          String            @id @default(cuid())
  workspaceId String
  entityType  CustomFieldEntity
  name        String
  label       String
  fieldType   CustomFieldType
  options     Json? // For dropdown: ["Option A", "Option B"]
  required    Boolean           @default(false)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, name])
}

// ─── Attachments (R2 File Storage) ──────────────────────────────────────────

model Attachment {
  id            String   @id @default(cuid())
  workspaceId   String
  entityType    String // "company", "contact", "deal", "project", "invoice", "task", "logo"
  entityId      String // ID of the parent record
  name          String
  sizeBytes     Int?
  contentType   String?
  durationSec   Float? // media duration captured client-side at upload (audio/video)
  r2Key         String?
  status        String   @default("uploading") // uploading | uploaded | failed
  uploadId      String? // R2 multipart upload ID
  totalParts    Int      @default(1)
  uploadedParts Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  // Effort/duration lookups query by entity without workspaceId.
  @@index([entityType, entityId, status])
  @@index([r2Key])
}

// ─── Login Page Gallery ─────────────────────────────────────────────────────────
// Photos shown on the pre-auth sign-in page's scrolling gallery. Global (not
// workspace-scoped) since the sign-in page has no workspace context yet.

model LoginPhoto {
  id          String   @id @default(cuid())
  r2Key       String
  contentType String?
  column      String   @default("a") // "a" (left, scrolls up) | "b" (right, scrolls down)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([column, order])
}

// ─── App Branding ───────────────────────────────────────────────────────────────
// Uploaded logo/icon assets (favicon, PWA icons, web logo, OG image) managed in
// Settings → App Logo. Global (not workspace-scoped): the favicon, manifest and
// sign-in page all render before any workspace context exists. One row per
// concrete served asset — Android slots store a row per size (192 + 512).

model BrandingAsset {
  id          String   @id @default(cuid())
  slot        String   @unique // favicon | appleTouchIcon | androidAny192 | androidAny512 | androidMaskable192 | androidMaskable512 | webLogo | ogImage | androidMonochrome | iosSplash
  r2Key       String
  contentType String
  fileName    String
  width       Int      @default(0)
  height      Int      @default(0)
  size        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Publish Schedule ────────────────────────────────────────────────────────────

model PublishItem {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  taskId        String    @unique
  scheduledDate DateTime
  scheduledBy   String // WorkspaceMember ID
  published     Boolean   @default(false)
  publishedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduler WorkspaceMember @relation("PublishScheduler", fields: [scheduledBy], references: [id], onDelete: Cascade)

  @@index([projectId, scheduledDate])
  @@index([workspaceId, scheduledDate])
}

enum CustomFieldEntity {
  COMPANY
  CONTACT
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
  PHONE
}
