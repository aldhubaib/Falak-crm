generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Workspace ─────────────────────────────────────────────────────────────────

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  baseCurrency   String   @default("KWD")
  taxRate        Decimal  @default(15) @db.Decimal(5, 2)
  logo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members            WorkspaceMember[]
  activityLogs       ActivityLog[]
  industries         Industry[]
  referrals          Referral[]
  companies          Company[]
  contacts           Contact[]
  services           Service[]
  deals              Deal[]
  projects           Project[]
  invoices           Invoice[]
  pipelines          Pipeline[]
  projectStatuses    ProjectStatus[]
  taskStatuses       TaskStatus[]
  customFields       CustomFieldDef[]
  whatsappConfig     WhatsAppConfig?
  whatsappTemplates  WhatsAppTemplate[]
  roles              Role[]
  currencies         Currency[]
  exchangeRates      ExchangeRate[]
  attachments          Attachment[]
  checklistTemplates   ChecklistTemplate[]
  publishItems         PublishItem[]
}

// ─── Currencies & Exchange Rates ──────────────────────────────────────────────

model Currency {
  id          String   @id @default(cuid())
  workspaceId String
  code        String   // ISO: "KWD", "SAR", "USD", "EUR"
  name        String   // "Kuwaiti Dinar", "Saudi Riyal"
  symbol      String   // "د.ك", "﷼", "$"
  isBase      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  workspaceId    String
  fromCurrency   String   // e.g. "SAR"
  toCurrency     String   // always base currency e.g. "KWD"
  rate           Decimal  @db.Decimal(12, 6) // 1 fromCurrency = X toCurrency
  effectiveDate  DateTime @default(now())
  createdAt      DateTime @default(now())

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, fromCurrency, toCurrency])
}

// ─── Team & Roles ──────────────────────────────────────────────────────────────

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String       // Clerk user ID
  email       String
  name        String?
  type        MemberType   @default(MEMBER)
  roleId      String?
  joinedAt    DateTime     @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role?        @relation(fields: [roleId], references: [id])
  assignedTasks Task[]     @relation("TaskAssignee")
  comments      TaskComment[]    @relation("CommentAuthor")
  mentionedIn   CommentMention[] @relation("MentionedIn")
  notifications  Notification[]   @relation("NotificationRecipient")
  scheduledItems PublishItem[]    @relation("PublishScheduler")

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum MemberType {
  OWNER
  MEMBER
  FREELANCER
}

model Role {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  permissions Json     // { deals: "full", invoices: "view", ... }
  createdAt   DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]

  @@unique([workspaceId, name])
}

// ─── Freelancer Access ─────────────────────────────────────────────────────────

model ProjectCollaborator {
  id          String              @id @default(cuid())
  projectId   String
  memberId    String
  status      CollaboratorStatus  @default(PENDING)
  invitedAt   DateTime            @default(now())
  invitedVia  String?             // "whatsapp" | "email"

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ─── Companies & Contacts ──────────────────────────────────────────────────────

model Company {
  id             String    @id @default(cuid())
  workspaceId    String
  ownerId        String?   // Clerk user ID of record owner
  ownerName      String?
  name           String
  nameAr         String?
  industry       String?
  referral       String?
  phone          String?
  whatsappNumber String?
  email          String?
  website        String?
  address        String?
  logo           String?
  notes          String?
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts       ContactCompany[]
  deals          Deal[]
  projects       Project[]

  @@index([workspaceId, deletedAt])
}

model Contact {
  id              String   @id @default(cuid())
  workspaceId     String
  ownerId         String?  // Clerk user ID of record owner
  ownerName       String?
  firstName       String
  middleName      String?
  lastName        String
  nameAr          String?
  mobile          String
  email           String?
  role            String?
  country         String
  notes           String?
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companies       ContactCompany[]
  deals           Deal[]
  invoices        Invoice[]
  whatsappMessages WhatsAppMessage[]

  @@unique([workspaceId, mobile])
  @@index([workspaceId, deletedAt])
}

model ContactCompany {
  id        String   @id @default(cuid())
  contactId String
  companyId String
  role      String?  // Role at this specific company
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
}

// ─── Services Catalog ──────────────────────────────────────────────────────────

model Service {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  pricingType   PricingType  @default(FIXED)
  unitPrice     Decimal      @db.Decimal(12, 2)
  unit          String?      // "month", "piece", "hour", etc.
  taxable       Boolean      @default(true)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dealItems     DealItem[]
  tasks         Task[]
}

enum PricingType {
  FIXED
  MONTHLY
  PER_UNIT
  HOURLY
}

// ─── Pipelines & Stages (Dynamic) ─────────────────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages      PipelineStage[]
  deals       Deal[]

  @@index([workspaceId, isDefault])
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  color       String    @default("#3b82f6")
  type        StageType @default(OPEN)
  createdAt   DateTime  @default(now())

  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@unique([pipelineId, order])
}

enum StageType {
  OPEN
  WON
  LOST
}

// ─── Deals ─────────────────────────────────────────────────────────────────────

model Deal {
  id              String   @id @default(cuid())
  workspaceId     String
  pipelineId      String
  stageId         String
  companyId       String?
  contactId       String?
  ownerId         String?  // Clerk user ID of record owner
  ownerName       String?
  title           String
  value           Decimal  @db.Decimal(12, 2)
  currency        String   @default("KWD")
  rateToBase      Decimal? @db.Decimal(12, 6) // Locked exchange rate at time of creation
  valueInBase     Decimal? @db.Decimal(12, 2) // Value converted to base currency using locked rate
  expectedCloseDate DateTime?
  discountType    String   @default("percent") // "percent" or "fixed"
  discountValue   Decimal  @default(0) @db.Decimal(12, 3)
  lostReason      String?
  notes           String?
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  closedAt        DateTime?
  deletedAt       DateTime?

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items           DealItem[]
  project         Project?
  accessGrants    DealAccess[]

  @@index([workspaceId, deletedAt])
}

model DealAccess {
  id          String   @id @default(cuid())
  dealId      String
  email       String
  name        String?
  token       String   @unique @default(cuid())
  permissions Json     // { project: true, invoices: true, tasks: true }
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, email])
}

model DealItem {
  id          String   @id @default(cuid())
  dealId      String
  serviceId   String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  description String?  // Override description for this deal

  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id])

  @@index([dealId])
}

// ─── Projects ──────────────────────────────────────────────────────────────────

model ProjectStatus {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@unique([workspaceId, order])
}

model Project {
  id            String    @id @default(cuid())
  workspaceId   String
  dealId        String?   @unique
  companyId     String?
  contactId     String?
  ownerId       String?   // Clerk user ID of record owner
  ownerName     String?
  statusId      String?
  name          String
  type          String    @default("fixed") // "fixed" or "recurring"
  thumbnailId   String?   // File ID for project thumbnail
  description       String?
  requirePublishing Boolean   @default(false)
  startDate         DateTime?
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal          Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company       Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status        ProjectStatus?       @relation(fields: [statusId], references: [id])
  tasks              Task[]
  invoices           Invoice[]
  collaborators      ProjectCollaborator[]
  projectTemplates   ProjectTemplate[]
  folders            ProjectFolder[]
  assets             ProjectAsset[]
  publishItems       PublishItem[]

  @@index([workspaceId, deletedAt])
}

// ─── Project Assets ─────────────────────────────────────────────────────────────

model ProjectFolder {
  id         String   @id @default(cuid())
  projectId  String
  parentId   String?
  name       String
  createdAt  DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     ProjectFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   ProjectFolder[] @relation("FolderTree")
  assets     ProjectAsset[]

  @@index([projectId, parentId])
}

model ProjectAsset {
  id          String   @id @default(cuid())
  projectId   String
  folderId    String?
  name        String
  fileSize    Int
  contentType String
  r2Key       String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder      ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([projectId, folderId])
}

// ─── Checklist Templates ────────────────────────────────────────────────────────

model ChecklistTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String?
  color       String?  // hex color e.g. "#22d3ee"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       ChecklistTemplateItem[]
  projects    ProjectTemplate[]
}

model ChecklistTemplateItem {
  id                    String   @id @default(cuid())
  templateId            String
  name                  String
  type                  String   @default("text") // "text", "select", "file_upload", "textarea", "link", "yes_no", "checkbox"
  role                  String   @default("any")
  options               String?  // JSON array for select type e.g. '["Option A","Option B"]'
  allowedFileTypes      String?
  allowedFormats        String?  // JSON array e.g. '["mp4","mov"]'
  aspectRatio           String?  // e.g. "16:9", "9:16", "1:1"
  mandatory             Boolean  @default(false)
  phase                 String   @default("create") // "create" or "delivery"
  visibleFromStageId    String?
  requiredBeforeStageId String?
  order                 Int      @default(0)

  template              ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  visibleFromStage      TaskStatus?        @relation("VisibleFromStage", fields: [visibleFromStageId], references: [id], onDelete: SetNull)
  requiredBeforeStage   TaskStatus?        @relation("RequiredBeforeStage", fields: [requiredBeforeStageId], references: [id], onDelete: SetNull)
  taskItems             TaskChecklistItem[]

  @@index([templateId])
}

model ProjectTemplate {
  id         String @id @default(cuid())
  projectId  String
  templateId String

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([projectId, templateId])
}

model TaskChecklistItem {
  id                    String    @id @default(cuid())
  taskId                String
  templateItemId        String?
  name                  String
  type                  String    @default("text")
  role                  String    @default("any")
  options               String?
  allowedFileTypes      String?
  allowedFormats        String?   // JSON array e.g. '["mp4","mov"]'
  aspectRatio           String?   // e.g. "16:9", "9:16", "1:1"
  mandatory             Boolean   @default(false)
  phase                 String    @default("create") // "create" or "delivery"
  visibleFromStageId    String?
  requiredBeforeStageId String?
  completed             Boolean   @default(false)
  attachmentId          String?
  textValue             String?
  completedAt           DateTime?
  completedBy           String?
  order                 Int       @default(0)

  task           Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  templateItem   ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// ─── Tasks ─────────────────────────────────────────────────────────────────────

model TaskStatus {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  visibleFromItems       ChecklistTemplateItem[] @relation("VisibleFromStage")
  requiredBeforeItems    ChecklistTemplateItem[] @relation("RequiredBeforeStage")

  @@unique([workspaceId, order])
}

model Task {
  id           String   @id @default(cuid())
  projectId    String
  taskNumber   Int      @default(0)
  serviceId    String?  // Links back to the service item (if billable)
  statusId     String?
  assigneeId   String?  // WorkspaceMember ID (team or freelancer)
  title        String
  description  String?
  billable     Boolean  @default(true)
  price        Decimal? @db.Decimal(12, 2)
  priority     Int?
  dueDate      DateTime?
  completedAt  DateTime?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service        Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status         TaskStatus?        @relation(fields: [statusId], references: [id])
  assignee       WorkspaceMember?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  publishItem    PublishItem?

  @@index([projectId, statusId])
  @@index([projectId, order])
}

// ─── Comments ─────────────────────────────────────────────────────────────────

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  authorId    String   // WorkspaceMember ID
  body        String   // Plain text with @[Name](memberId) mentions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      WorkspaceMember  @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentions    CommentMention[]

  @@index([taskId, createdAt])
}

model CommentMention {
  id        String @id @default(cuid())
  commentId String
  memberId  String

  comment   TaskComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  member    WorkspaceMember  @relation("MentionedIn", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  recipientId String    // WorkspaceMember ID
  type        String    // "mention", "comment"
  title       String
  body        String?
  linkUrl     String?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  recipient   WorkspaceMember @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
}

// ─── Invoices ──────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  workspaceId   String
  projectId     String?
  contactId     String?
  number        String        // Auto-generated: INV-001, INV-002, etc.
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  rateToBase    Decimal?      @db.Decimal(12, 6) // Locked exchange rate at time of creation
  totalInBase   Decimal?      @db.Decimal(12, 2) // Total converted to base currency using locked rate
  currency      String        @default("KWD")
  notes         String?
  dueDate       DateTime?
  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  paidAt        DateTime?
  rejectionNote String?
  publicToken   String        @unique @default(cuid()) // For public invoice link
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsAppConfig {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  phoneNumberId   String
  accessToken     String
  verifyToken     String
  businessName    String?
  connected       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  event       String   // "invoice_sent", "invoice_reminder", "deal_update", etc.
  body        String   // Template with {{variables}}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, event])
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  contactId   String
  direction   MessageDirection
  body        String
  templateId  String?
  status      MessageStatus    @default(PENDING)
  linkedType  String?          // "invoice", "deal", "project"
  linkedId    String?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  contact     Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Activity Log ──────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String   // Clerk user ID
  userName    String?
  userImage   String?
  entityType  String   // "company", "contact", "deal", "project", "task", "invoice", "service"
  entityId    String
  entityName  String?  // Snapshot of the entity name at time of change
  action      String   // "created", "updated", "deleted", "moved", "sent", "accepted", "rejected", "paid"
  changes     Json?    // { field: { from: "old", to: "new" } }
  metadata    Json?    // Extra context (e.g. stage name for deal moves)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
}

// ─── Industries (Dynamic) ──────────────────────────────────────────────────────

model Industry {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Referral {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// ─── Custom Fields (Dynamic) ───────────────────────────────────────────────────

model CustomFieldDef {
  id          String          @id @default(cuid())
  workspaceId String
  entityType  CustomFieldEntity
  name        String
  label       String
  fieldType   CustomFieldType
  options     Json?           // For dropdown: ["Option A", "Option B"]
  required    Boolean         @default(false)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, name])
}

// ─── Attachments (R2 File Storage) ──────────────────────────────────────────

model Attachment {
  id            String    @id @default(cuid())
  workspaceId   String
  entityType    String    // "company", "contact", "deal", "project", "invoice", "task", "logo"
  entityId      String    // ID of the parent record
  name          String
  sizeBytes     Int?
  contentType   String?
  r2Key         String?
  status        String    @default("uploading") // uploading | uploaded | failed
  uploadId      String?   // R2 multipart upload ID
  totalParts    Int       @default(1)
  uploadedParts Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([r2Key])
}

// ─── Publish Schedule ────────────────────────────────────────────────────────────

model PublishItem {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  taskId        String    @unique
  scheduledDate DateTime
  scheduledBy   String    // WorkspaceMember ID
  published     Boolean   @default(false)
  publishedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduler    WorkspaceMember @relation("PublishScheduler", fields: [scheduledBy], references: [id], onDelete: Cascade)

  @@index([projectId, scheduledDate])
  @@index([workspaceId, scheduledDate])
}

enum CustomFieldEntity {
  COMPANY
  CONTACT
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
  URL
  PHONE
}
