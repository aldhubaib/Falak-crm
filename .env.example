# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Database (Railway PostgreSQL)
DATABASE_URL=
# Postgres connection pool size (per app instance). Default 20. Raise for higher
# concurrency; keep below your Postgres max_connections divided by replica count.
DB_POOL_MAX=20

# Realtime: the project board uses Server-Sent Events with an in-process event
# bus (src/lib/realtime.ts) — no extra config needed on a single instance.
# To run MULTIPLE app replicas, swap the in-process bus for a Redis pub/sub
# adapter so events fan out across instances (see src/lib/realtime.ts).

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=falak-crm

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
